<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
  </PropertyGroup>
  <ItemGroup>
    <_RedBoltExternalDesktopProject Include="../Native/RedBolt.XR.Native.csproj;../Native/OpenXR/RedBolt.Bindings.OpenXR.csproj;../XR/RedBolt.XR.csproj" Condition="'$(RedBoltXREnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="../Sample/HelloVR/RedBolt.Sample.HelloVR.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
    <_RedBoltExternalDesktopProject Include="$(RedBoltTestsProject)" Condition="'$(RedBoltTestsEnabled)' == 'true' and Exists('$(RedBoltTestsProject)')" />
    <_RedBoltExternalAndroidProject Include="../Native/RedBolt.XR.Native.Android.csproj;../Native/OpenXR/RedBolt.Bindings.OpenXR.csproj;../XR/RedBolt.XR.csproj" Condition="'$(RedBoltXREnabled)' == 'true'" />
    <_RedBoltExternalAndroidProject Include="../Sample/Android/RedBolt.Sample.Android.csproj" Condition="'$(RedBoltSamplesEnabled)' == 'true'" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Build.targets" />
</Project>
