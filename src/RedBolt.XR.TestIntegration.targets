<Project>
  <!-- Registers this module (with native assets) with the shared test-integration logic. -->
  <ItemGroup>
    <RedBoltExternalTestModule Include="$(RedBoltXRRoot)" HasNative="true" />
  </ItemGroup>
  <Import Project="$(RedBoltRoot)/eng/RedBolt.ModuleBuild/TestIntegration.targets" Condition="'$(RedBoltExternalTestIntegrationImported)' != 'true'" />
</Project>
