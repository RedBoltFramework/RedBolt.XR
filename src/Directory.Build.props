<Project>
  <PropertyGroup>
    <RedBoltXRRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RedBoltXRRoot>
    <RedBoltRoot Condition="'$(RedBoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltXRRoot)/../RedBolt'))</RedBoltRoot>
    <RedBoltPhysicsJoltRoot Condition="'$(RedBoltPhysicsJoltRoot)' == ''">$([System.IO.Path]::GetFullPath('$(RedBoltXRRoot)/../RedBolt.PhysicsJolt'))</RedBoltPhysicsJoltRoot>
    <RedBoltDearImGuiEnabled>true</RedBoltDearImGuiEnabled>
    <RedBoltExternalModuleRoot>$(RedBoltXRRoot)</RedBoltExternalModuleRoot>
    <RedBoltExternalModuleName>RedBolt.XR</RedBoltExternalModuleName>
    <RedBoltExternalBuildProjectName>RedBolt.XR.Build</RedBoltExternalBuildProjectName>
    <RedBoltExternalGeneratorProjectName>RedBolt.XR.Generator.Dependencies</RedBoltExternalGeneratorProjectName>
    <RedBoltExternalGeneratorProjectPrefix>RedBolt.XR.Generator.</RedBoltExternalGeneratorProjectPrefix>
    <RedBoltExternalNativeAndroidProjectName>RedBolt.XR.Native.Android</RedBoltExternalNativeAndroidProjectName>
    <RedBoltExternalModuleProjectNames>RedBolt.XR;RedBolt.Bindings.OpenXR</RedBoltExternalModuleProjectNames>
    <RedBoltExternalGeneratedBindingsDirectory>redbolt-xr-native</RedBoltExternalGeneratedBindingsDirectory>
    <RedBoltExternalBindingsSubdirectory>openxr</RedBoltExternalBindingsSubdirectory>
    <RedBoltExternalBindingsProjectName>RedBolt.Bindings.OpenXR</RedBoltExternalBindingsProjectName>
    <RedBoltExternalHasNative>true</RedBoltExternalHasNative>
    <RedBoltExternalHasNativeWeb>false</RedBoltExternalHasNativeWeb>
    <RedBoltExternalUsesDearImGui>true</RedBoltExternalUsesDearImGui>
    <RedBoltExternalNativeTargetPrefix>redbolt-xr</RedBoltExternalNativeTargetPrefix>
    <RedBoltExternalEnabledNativeModules>OPENXR</RedBoltExternalEnabledNativeModules>
    <RedBoltExternalDesktopResourceRoot>$(RedBoltXRRoot)</RedBoltExternalDesktopResourceRoot>
  </PropertyGroup>
  <Import Project="$(RedBoltRoot)/src/RedBolt/Build/Directory.Build.props" />
  <PropertyGroup>
    <RedBoltExternalModuleEnabled>$(RedBoltXREnabled)</RedBoltExternalModuleEnabled>
    <RedBoltExternalModuleBuildProperties>RedBoltXREnabled=$(RedBoltXREnabled)</RedBoltExternalModuleBuildProperties>
  </PropertyGroup>
</Project>
