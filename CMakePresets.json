{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/native/${presetName}"
    },
    {
      "name": "win-x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": { "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../RedBolt/cmake/Toolchains/MinGW-x86_64.cmake" }
    },
    {
      "name": "android-x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake"
      }
    },
    {
      "name": "android-arm64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native/${presetName}",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake"
      }
    }
  ]
}
