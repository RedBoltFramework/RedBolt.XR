<Project>
  <PropertyGroup>
    <RedBoltXREnabled Condition="$([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',all,')) or $([System.String]::Copy('$(_RedBoltEnableModulesList)').Contains(',xr,'))">true</RedBoltXREnabled>
    <RedBoltXREnabled Condition="'$(RedBoltXREnabled)' == '' and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',all,')) and !$([System.String]::Copy('$(_RedBoltDisableModulesList)').Contains(',xr,'))">true</RedBoltXREnabled>
    <RedBoltXREnabled Condition="'$(RedBoltXREnabled)' == ''">false</RedBoltXREnabled>
  </PropertyGroup>
</Project>
